{
  "name": "kishore-theiveekan-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-runtime.mjs && next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\"",
    "build": "node scripts/build-runtime.mjs && next build && node scripts/strip-react.mjs out",
    "start": "node -e \"import('./qa/serve.mjs').then((m) => m.serve('out', 3000)).then(() => console.log('http://127.0.0.1:3000'))\"",
    "test": "node qa/run.mjs && node qa/nav.mjs && node qa/gpu.mjs",
    "og": "node scripts/og.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.160.0",
    "esbuild": "0.25.5",
    "parse5": "^8.1.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
